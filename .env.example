DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=1550468626774237255
GUILD_ID=your_server_id_here

# Security
# Твой Discord user id — топовые команды (ban/warn/automod/…) только для этих id
OWNER_IDS=
ALLOWED_GUILD_IDS=
# Кто может юзать остальные команды (пусто = все). Публичные /ping /level и т.п. всегда открыты.
# OWNER_IDS всегда могут.
ALLOWED_ROLE_IDS=
LEAVE_UNKNOWN_GUILDS=true
# Локально можно ENABLE_BOT_LOCK=true; на FadeHost не нужно
ENABLE_BOT_LOCK=false

# Каналы / роли
WELCOME_CHANNEL_ID=
WELCOME_CARD=true
AUTO_ROLE_ID=
MEMBER_LOG_CHANNEL_ID=
ROLE_LOG_CHANNEL_ID=
SERVER_LOG_CHANNEL_ID=
MESSAGE_LOG_CHANNEL_ID=
INFO_USER_CHANNEL_ID=
BIRTHDAY_CHANNEL_ID=

# Временные войсы: hub = канал "Создать комнату"
TEMP_VOICE_HUB_ID=
TEMP_VOICE_CATEGORY_ID=

# Статистика (каналы только для названия)
STATS_MEMBERS_CHANNEL_ID=
STATS_ONLINE_CHANNEL_ID=

# AFK detect (перенос в AFK-канал если mute/deaf N минут)
AFK_DETECT=true
AFK_MINUTES=10
AFK_CHANNEL_ID=

# Левелинг / активность
LEVEL_MESSAGE_XP=true
LEVEL_VOICE_XP=true
# XP за минуту в войсе (нужен ещё кто-то в канале, не AFK)
LEVEL_VOICE_XP_AMOUNT=5

# Варны → авто-эскалация (0 = выкл)
# timeout после N варнов; kick после M (kick важнее на том же пороге)
WARN_TIMEOUT_AT=3
WARN_TIMEOUT_MINUTES=60
WARN_KICK_AT=5

# Бэкап JSON (src/data/backups/YYYY-MM-DD)
BACKUP_ENABLED=true
BACKUP_KEEP_DAYS=7

# Автомод (дефолты; runtime: /automod toggle · ignore)
AUTOMOD_INVITES=true
AUTOMOD_SPAM=true
AUTOMOD_WORDS=true
AUTOMOD_CAPS=true
AUTOMOD_LINKS=true
AUTOMOD_RAID=true
AUTOMOD_CAPS_PERCENT=70
AUTOMOD_CAPS_MIN_LEN=8
AUTOMOD_LINKS_MAX=3
AUTOMOD_RAID_JOINS=5
AUTOMOD_RAID_WINDOW_SEC=10
